# StaySphere Server Environment Configuration Example
# Copy to .env for local development

PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Leave empty to automatically use embedded MongoMemoryServer for instant local zero-config execution
MONGODB_URI=mongodb://localhost:27017/staysphere

# Authentication Secrets
JWT_SECRET=staysphere_super_secret_jwt_key_for_development_only_2026
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Pricing & Taxes
TAX_RATE_PERCENT=12

# Payment Provider: 'demo' or 'razorpay'
PAYMENT_PROVIDER=demo

# Optional Razorpay Credentials (required only if PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere
